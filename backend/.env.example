SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>
# Supabase → Connect → Shared Pooler → Transaction mode (port 6543, IPv4).
# Paste the URI from the dashboard; plain postgresql:// is auto-converted to psycopg3.
# URL-encode special characters in the password (! → %21, @ → %40, etc.).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-us-west-2.pooler.supabase.com:6543/postgres
# Local only (`supabase start`):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
CORS_ORIGINS=http://localhost:5173
# OpenAI — required for check-up voice agent and RAG embeddings/chat
OPENAI_API_KEY=sk-...
# RAG / Health Documents (defaults shown; override if you rename them)
SUPABASE_DOCUMENTS_TABLE=health_documents
SUPABASE_HEALTH_DOCS_BUCKET=health-documents
SUPABASE_CHECKUP_TABLE=checkup_sessions
# Resend — Email reminders for daily check-ins
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=NatalNanny <reminders@yourdomain.com>
APP_DASHBOARD_URL=https://natalnanny.app/dashboard
