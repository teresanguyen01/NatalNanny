SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=<jwt-secret>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>
# Supabase Dashboard → Project Settings → Database → URI (Session pooler is fine).
# Plain postgresql:// from Supabase is auto-converted to psycopg3 in config.
# Local `supabase start` default:
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
CORS_ORIGINS=http://localhost:5173
# OpenAI — required for check-up voice agent (ephemeral Realtime token issuance)
OPENAI_API_KEY=sk-...
