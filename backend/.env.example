SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>
# Supabase → Connect → Shared Pooler → Transaction mode (port 6543, IPv4).
# Paste the URI from the dashboard; plain postgresql:// is auto-converted to psycopg3.
# URL-encode special characters in the password (! → %21, @ → %40, etc.).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-us-west-2.pooler.supabase.com:6543/postgres
# Local only (`supabase start`):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
CORS_ORIGINS=http://localhost:5173
# OpenAI — required for check-up voice agent (ephemeral Realtime token issuance)
OPENAI_API_KEY=sk-...
